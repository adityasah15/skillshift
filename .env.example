# Copy to .env and fill in real values. Never commit .env — it holds secrets.
# See README "Environment" + "Production SMTP" notes.

NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillshift
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:3001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
# S3 auth comes from the EC2 instance IAM role (no keys in .env).
AWS_REGION=eu-north-1
AWS_S3_BUCKET=skillshift-dev-uploads

# Production SMTP (required). The API crashes on boot without it:
# MailService throws if SMTP_HOST is missing, or if it contains
# "ethereal.email" while NODE_ENV=production.
# This demo uses Gmail SMTP (no custom domain): create a dedicated Gmail
# account, enable 2FA, generate an App Password, strip the spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=skillshift.noreply@gmail.com
SMTP_PASS=
MAIL_FROM="SkillShift <skillshift.noreply@gmail.com>"
