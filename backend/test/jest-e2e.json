{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/bullmq|@nestjs/bull-shared|@nestjs/jwt|@nestjs/passport)/)"
  ],
  "moduleNameMapper": {
    "^generated/(.*)$": "<rootDir>/../generated/$1",
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
